# This is a template for the .env.secrets file used by the docker compose
# Injected into the mlflow and dolt containers only; non-secret settings (ports,
# MLflow, S3, Dolt overrides, ...) belong in .env (see .env.template).
SCION_ADMIN_EMAIL=<email>
SCION_SERVER_AUTH_EMAIL=<email>
SCION_SERVER_AUTH_DISPLAYNAME=<full name>
# API key of the model provider MLflow routes to (asf.yaml mlflow.provider);
# not needed for a keyless provider such as ollama. make setup asks for it.
MODEL_PROVIDER_API_KEY=<key>
# Agent GitHub PATs are stored directly in the Hub by make setup-github, not here.
# Optional: API key of the agent gateway (asf.yaml agent_gateway); not needed for
# the local MLflow gateway (setup then uses a placeholder agents require)
AGENT_GATEWAY_API_KEY=<key>
# --- Dolt / Beads ; see dolt/README.md ---
# Each 32-128 chars of [A-Za-z0-9_-], e.g. `openssl rand -hex 24`. Set once: changing
# them later does not rotate existing Dolt grants (initialised on first start only).
DOLT_DB_PASSWORD=<32-128 chars [A-Za-z0-9_-]>
DOLT_ROOT_PASSWORD=<32-128 chars [A-Za-z0-9_-]>
